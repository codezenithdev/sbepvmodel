# Copy this file to .env (or set these as real environment variables) and fill in your key.
# The script reads BAZEFIELD_API_KEY / BAZEFIELD_BASE_URL from the environment.
# Do NOT commit your real key.

# Required: your Bazefield API key (from the Bazefield User Manager).
BAZEFIELD_API_KEY=your-key-here

# Optional: defaults to https://bazefield.sbenergy-us.com/Bazefield.Services/api/
# BAZEFIELD_BASE_URL=https://bazefield.sbenergy-us.com/Bazefield.Services/api/

# Required for the dashboard chat endpoint.
OPENAI_API_KEY=your-openai-key-here

# Required for a shared Render deployment. Leave unset for unprotected local dev.
DASHBOARD_BASIC_USER=dashboard-user
DASHBOARD_BASIC_PASSWORD=replace-with-a-strong-shared-password

# Optional: current defaults are defined in sbepv.api.config.
# OPENAI_MODEL=gpt-5.6-sol
# OPENAI_REASONING_EFFORT=high

# Optional: defaults to ./outputs locally. On Render, use a persistent disk and set:
# PV_DASHBOARD_OUTPUT_DIR=/var/data/outputs

# Optional: comma-separated origins allowed to call the FastAPI model API from
# a hosted Sites dashboard. Add the deployed Sites URL when live API mode is used.
# PV_DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Autonomy rollout is fail-closed. Shadow mode defaults true and blocks scenario
# execution, evidence acceptance, recommendation activation, sign-off, and final
# reports. Set the completed behavior-eval count only from reviewed CI evidence;
# 20 automated cases and 10 distinct, verified draft-report shadow cases are required.
# DECISION_AGENT_ENABLED=true
# DECISION_AGENT_SHADOW_MODE=true
# DECISION_AGENT_BEHAVIOR_EVAL_CASES=0
#
# Turn budget. The timeout bounds ONE model attempt, not the whole turn: a why_not
# answer at high reasoning effort measures around 35 s. Repair attempts re-ask the
# model when its reply breaks the output contract, which is transient; timeouts and
# transport errors are never repaired. The turn deadline is derived as
# timeout * (1 + repair attempts) + 5, and the stale sweep always outlasts it.
# DECISION_AGENT_TIMEOUT_SECONDS=60      # 5-90, per attempt
# DECISION_AGENT_REPAIR_ATTEMPTS=1       # 0-2, set 0 to disable repair
# DECISION_AGENT_MAX_OUTPUT_TOKENS=4000  # 1200-8000, includes reasoning tokens
# DECISION_AGENT_REASONING_EFFORT=high   # minimal | low | medium | high
